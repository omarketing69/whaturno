# Base de datos (SQLite en desarrollo; para PostgreSQL cambia provider en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# URL pública de la app (se usa en links de seguimiento y QR)
APP_URL="http://localhost:3000"

# SMS: "console" (desarrollo, solo imprime en consola) | "bird"
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER=""
BIRD_WORKSPACE_ID=""
BIRD_CHANNEL_ID=""

# Telegram (opcional). El cliente debe iniciar el bot para poder recibir mensajes.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
