# Base de datos (SQLite en desarrollo; para PostgreSQL cambia provider en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# URL pública de la app (se usa en links de seguimiento y QR)
APP_URL="http://localhost:3000"

# SMS: "console" (desarrollo, solo imprime en consola) | "labsmobile"
SMS_PROVIDER="console"
# LabsMobile: usuario de la cuenta (correo) y token de API (panel de LabsMobile → API)
LABSMOBILE_USERNAME=""
SMS_API_KEY=""
# Remitente opcional (máx. 11 caracteres alfanuméricos)
SMS_SENDER=""
# "1" = modo simulado de LabsMobile (no envía ni consume saldo)
LABSMOBILE_TEST=""

# Telegram (opcional). El cliente debe iniciar el bot para poder recibir mensajes.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
